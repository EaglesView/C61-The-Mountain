[
  {
    "label": "Godot: Run Game",
    "command": "bash",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/run-godot.sh",
      "--path",
      "$ZED_WORKTREE_ROOT/dev-game",
    ],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Godot: Run Game (Debug)",
    "command": "bash",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/run-godot.sh",
      "--path",
      "$ZED_WORKTREE_ROOT/dev-game",
      "--verbose",
    ],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Godot: Open Editor",
    "command": "bash",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/run-godot.sh",
      "--editor",
      "--path",
      "$ZED_WORKTREE_ROOT/dev-game",
    ],
    "allow_concurrent_runs": false,
    "reveal": "never",
  },
  {
    "label": "Net: Server (headless)",
    "command": "bash",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/run-godot.sh",
      "--path",
      "$ZED_WORKTREE_ROOT/dev-game",
      "--headless",
      "--server",
    ],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Net: Client (connect localhost)",
    "command": "bash",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/run-godot.sh",
      "--path",
      "$ZED_WORKTREE_ROOT/dev-game",
      "--connect",
    ],
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "Net: Client (connect Server Amaricain)",
    "command": "bash",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/run-godot.sh",
      "--path",
      "$ZED_WORKTREE_ROOT/dev-game",
      "--connect=5.78.190.227",
    ],
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "Server: SSH Shell",
    "command": "ssh",
    "args": ["godotadmin@5.78.190.227"],
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "Server: Status",
    "command": "ssh",
    "args": ["godotadmin@5.78.190.227", "sudo systemctl status godot-server"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Server: Start",
    "command": "ssh",
    "args": ["godotadmin@5.78.190.227", "sudo systemctl start godot-server"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Server: Stop",
    "command": "ssh",
    "args": ["godotadmin@5.78.190.227", "sudo systemctl stop godot-server"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Server: Logs (live)",
    "command": "ssh",
    "args": ["godotadmin@5.78.190.227", "journalctl -fu godot-server"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "Server: Deploy",
    "command": "bash",
    "args": ["$ZED_WORKTREE_ROOT/scripts/deploy-server.sh"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "C#: Build",
    "command": "dotnet",
    "args": ["build", "$ZED_WORKTREE_ROOT/dev-game/dev-game.csproj"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
  {
    "label": "C#: Clean",
    "command": "dotnet",
    "args": ["clean", "$ZED_WORKTREE_ROOT/dev-game/dev-game.csproj"],
    "allow_concurrent_runs": false,
    "reveal": "always",
  },
]
