[
  {
    "label": "C#: Attach to Godot",
    "adapter": "coreclr",
    "request": "attach",
    "processId": "${command:pickProcess}",
  },
  {
    "label": "C#: Launch via Godot",
    "adapter": "coreclr",
    "request": "launch",
    "program": "$env(GODOT_BIN)",
    "args": ["--path", "${ZED_WORKTREE_ROOT}/dev-game"],
    "cwd": "${ZED_WORKTREE_ROOT}/dev-game",
    "stopAtEntry": false,
    "console": "internalConsole",
  },
]
